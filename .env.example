# Local optional configuration for live smoke checks and future live provider orchestration.
# Copy to .env for your machine only. Do not put real secrets in this example file.

# Live tests stay skipped unless this is set to 1.
NLP_STOCK_PREDICTION_ALLOW_LIVE_TESTS=0

# Required when running the SEC live API smoke test.
NLP_STOCK_PREDICTION_LIVE_USER_AGENT=

# Required when running the configured public scraping smoke test.
NLP_STOCK_PREDICTION_LIVE_SCRAPE_URL=
NLP_STOCK_PREDICTION_LIVE_SCRAPE_EXPECT_TEXT=

# Reserved for future live LLM smoke. Leave at 0 until live LLM adapter wiring is enabled.
NLP_STOCK_PREDICTION_LIVE_LLM_SMOKE=0

# Provider credential conventions for future live orchestration/manual adapter wiring.
NLP_STOCK_PREDICTION_ALPHA_VANTAGE_API_KEY=
NLP_STOCK_PREDICTION_FRED_API_KEY=

# X API credentials from your X Developer App "Keys and tokens" page.
# X docs also call the API Key and API Secret the Consumer Key and Consumer Secret.
# The Bearer Token is used for read-only app-only recent-search requests.
NLP_STOCK_PREDICTION_X_API_KEY=
NLP_STOCK_PREDICTION_X_API_SECRET=
NLP_STOCK_PREDICTION_X_BEARER_TOKEN=

NLP_STOCK_PREDICTION_NEWS_API_KEY=
